# ---- Python ----
# Bytecode, virtual environments, packaging output and tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- MyST ----
# mystmd writes everything it builds under _build/ beside myst.yml (here
# book/_build/): the site, HTML, exports, the execution cache and logs.
# Regenerated by "myst build"; never committed.
_build/

# ---- Run artifacts ----
# The proof transcript (gkr ... -t proof.json) and the prover-secrets file
# (gkr ... -S prover.txt) written while demonstrating.
/proof.json
/prover.txt

# ---- Local working material ----
# Working material kept beside the project, outside version control.
excluded/

# ---- Local notes ----
# A separate local repository, not part of this project.
/sumcheck-gkr-notes-private/
# Backstop: if a note lands here by mistake, git will not take it.
/handoff.txt
/backlog.txt
/backup.txt
/devnotes.txt

# ---- Update zips ----
# Temporary archives, extracted in place and then deleted.
/*-update-*.zip

# ---- Office lock files ----
~$*

# ---- OS and editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
